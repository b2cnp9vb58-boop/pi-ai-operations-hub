# Copy the required values into root-owned files under /etc/pi-ai-operations-hub/.
# Do not load this example file in production and never commit a real .env file.
PI_CONTROL_HOST=127.0.0.1
PI_CONTROL_PORT=4330
PI_CONTROL_DATA_DIR=/var/lib/pi-ai-operations-hub
PI_CONTROL_CLAUDE_BIN=/usr/local/bin/claude
PI_CONTROL_CLAUDE_CWD=/opt/pi-ai-operations-hub/workspace
PI_CONTROL_TELEGRAM_KEY=<generate-at-install-time>
PI_CONTROL_WEB_KEY=<generate-at-install-time>
PI_CONTROL_ADMIN_KEY=<generate-at-install-time>
PI_CONTROL_HOOK_KEY=<generate-at-install-time>
PI_CONTROL_WEIXIN_KEY=<generate-at-install-time>
TELEGRAM_BOT_TOKEN=<replace-with-your-token>
WEIXIN_BOT_TOKEN=<replace-with-your-token>
